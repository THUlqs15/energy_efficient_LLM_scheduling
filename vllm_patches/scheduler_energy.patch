+        if hasattr(req, "arrival_time") and req.arrival_time is not None:
+            return float(req.arrival_time) * 1000.0
+        return now_ms
+
+    def _energy_extract_slos(self, req):
+        sp = getattr(req, "sampling_params", None)
+        ea = getattr(sp, "extra_args", {}) if sp else {}
+        if not isinstance(ea, dict):
+            ea = {}
+        ttft = float(ea.get("ttft_ms", self._ecfg.default_ttft_ms))
+        tpot = float(ea.get("tpot_ms", self._ecfg.default_tpot_ms))
+        w_n = float(ea.get("w_n", self._ecfg.default_w_n))
+        return ttft, tpot, w_n
+
+    def _energy_ensure_req_state(self, rid, req, now_ms: float):
+        if rid in self._ereq_state:
+            return
+        ttft_slo, tpot_slo, w_n = self._energy_extract_slos(req)
+        arrival_ms = self._energy_get_arrival(req, now_ms)
+        self._ereq_state[rid] = {
+            "arrival_ms": arrival_ms,
+            "w_n": w_n,
+            "ttft_slo_ms": ttft_slo,
+            "tpot_slo_ms": tpot_slo,
+            "ttft_fired": False,
+            "first_tok_ms": None,
+            "last_num_out": 0,
+        }
+
