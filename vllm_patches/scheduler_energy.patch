+            tpot_ratio = avg_tpot_obs_ms / slo
+            tpot_pos_viol = max(0.0, tpot_ratio - 1.0)
+            delta = cfg.eta_tpot * st["w_n"] * (tpot_pos_viol - 0.05)
+            cfg.w_tpot = max(0.01, cfg.w_tpot + delta)
+            n_tpot += 1
+
+        return n_ttft, n_tpot
