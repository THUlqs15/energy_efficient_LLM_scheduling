+        cfg = self._ecfg
+        visible_ids: set[str] = set()
+        running_view = []
+        for req in self.running:
+            rid = req.request_id
+            visible_ids.add(rid)
+            running_view.append((rid, req))
+            self._energy_ensure_req_state(rid, req, now_ms)
+        for req in self.waiting:
+            rid = req.request_id
+            visible_ids.add(rid)
+            self._energy_ensure_req_state(rid, req, now_ms)
+
+        n_ttft = 0
+        for rid, req in running_view:
+            st = self._ereq_state[rid]
+            n_out = int(getattr(req, "num_output_tokens", 0))
+            st["last_num_out"] = n_out
+            if n_out >= 1 and not st["ttft_fired"]:
