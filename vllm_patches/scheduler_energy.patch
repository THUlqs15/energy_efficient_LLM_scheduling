+        if self._ecfg.preempt_mode != 2:
+            return original_w_n
+        return original_w_n * self._epreempt_multiplier.get(request_id, 1.0)
+
+    def _energy_get_arrival(self, req, now_ms: float) -> float:
+        sp = getattr(req, "sampling_params", None)
+        ea = getattr(sp, "extra_args", {}) if sp else {}
+        if isinstance(ea, dict):
